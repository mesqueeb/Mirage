{
  "name": "Mirage",
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "test": "echo todo",
    "sync-readme": "replace-regex --from=\"\\d+\\.\\d+\\.\\d+\" --to=\"$npm_package_version\" README.md",
    "release": "pnpm test && bumpp --no-push --all -x \"pnpm run sync-readme\" && git push --follow-tags && gh release create $(git describe --tags --abbrev=0) --generate-notes"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "bumpp": "^12.3.0",
    "replace-regex": "^0.0.3"
  },
  "funding": "https://github.com/sponsors/mesqueeb",
  "repository": {
    "type": "git",
    "url": "https://github.com/mesqueeb/Mirage.git"
  },
  "homepage": "https://github.com/mesqueeb/Mirage#readme",
  "bugs": "https://github.com/mesqueeb/Mirage/issues",
  "packageManager": "pnpm@11.27.0"
}
